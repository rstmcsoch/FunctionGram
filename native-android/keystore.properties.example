# Copy to native-android/keystore.properties (gitignored) or point
# FUNCTIONGRAM_RELEASE_SIGNING_FILE at a file outside the repository.
# Do not commit real values. Leave these empty in git.
#
# storeFile: absolute path, or a path relative to native-android/.
# Keep the keystore file outside the repository.
#
# Environment variables override the same keys in the properties file:
#   FUNCTIONGRAM_RELEASE_STORE_FILE
#   FUNCTIONGRAM_RELEASE_STORE_PASSWORD
#   FUNCTIONGRAM_RELEASE_KEY_ALIAS
#   FUNCTIONGRAM_RELEASE_KEY_PASSWORD

storeFile=
storePassword=
keyAlias=
keyPassword=
