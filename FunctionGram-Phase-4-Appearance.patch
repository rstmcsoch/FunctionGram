+}
+export function targetEnabled(a:Appearance,target:string):boolean {return !NAV_TARGETS.includes(target as typeof NAV_TARGETS[number])||a.nav.some(n=>n.enabled&&(n.target===target||n.target==='/#/'+target||n.target==='/#'+target));}
