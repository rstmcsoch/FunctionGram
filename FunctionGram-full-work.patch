+.viewer-list{list-style:none;margin:0;padding:0;overflow-y:auto;display:flex;flex-direction:column;gap:10px}
+.viewer-list li{display:flex;align-items:center;gap:11px}
+.viewer-list li span{display:flex;flex-direction:column;min-width:0}
+.viewer-list li strong{font-size:14px;color:#fff}
+.viewer-list li small{font-size:12.5px;color:rgba(255,255,255,.65);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.story-viewers .muted{color:rgba(255,255,255,.75)}
+
+/* tap zones are real buttons now: reset their chrome (geometry stays from the base rule) */
+button.story-tap{background:none;border:none;cursor:pointer;-webkit-tap-highlight-color:transparent}
+button.story-tap:focus-visible{outline:2px solid rgba(255,255,255,.9);outline-offset:-3px}
+
+/* post viewer: load earlier comments */
+.load-more-comments{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;margin:6px 0 10px}
+
+/* ---------- auth form: forgot password ---------- */
+.auth-form .forgot-link{display:block;margin:2px 0 0;background:none;border:none;color:var(--muted-foreground);font-size:13.5px;cursor:pointer;padding:6px 2px}
+.auth-form .forgot-link:hover{color:var(--primary)}
+
+/* ---------- settings entry in menus ---------- */
+.more-menu{min-width:210px}
+
+/* responsive: stack settings rows on narrow screens */
+@media (max-width:480px){
+  .settings-row{flex-direction:column;align-items:flex-start}
+  .settings-row .switch{align-self:flex-end}
+  .media-detail-row{grid-template-columns:1fr}
+  .media-detail-row select{justify-self:start}
+  .story-viewers{width:88%}
+  .profile-actions .profile-safety{width:100%;justify-content:flex-start}
+}
