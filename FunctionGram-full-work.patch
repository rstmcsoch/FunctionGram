+/* Smoke test: hashtag + mention round-trip against the running dev server.
+   Uses the local you.preview session; creates and deletes its own post. */
+import { readFileSync } from 'node:fs';
+
+const BASE = 'http://127.0.0.1:3000';
+const lines = readFileSync('/tmp/fg.cookies', 'utf8').split('\n').map(l => l.startsWith('#HttpOnly_') ? l.slice(10) : l).filter(l => l && !l.startsWith('#'));
+const cookie = lines.map(l => { const p = l.split('\t'); return p.length >= 7 ? `${p[5]}=${p[6]}` : ''; }).filter(Boolean).join('; ');
+if (!cookie) { console.error('no cookies parsed'); process.exit(2); }
+const H = { cookie };
+async function get(u) { const r = await fetch(BASE + u, { headers: H }); return { status: r.status, body: await r.json().catch(() => null) }; }
+async function post(body) { const r = await fetch(BASE + '/api/social', { method: 'POST', headers: { ...H, 'content-type': 'application/json' }, body: JSON.stringify(body) }); return { status: r.status, body: await r.json().catch(() => null) }; }
+let fails = 0;
+function check(name, ok, extra) { console.log((ok ? 'PASS' : 'FAIL') + '  ' + name + (extra ? '  → ' + extra : '')); if (!ok) fails++; }
+
+// 0. session identity
+const me = await get('/api/social');
+check('session alive (bootstrap)', me.status === 200, `status=${me.status}`);
+console.log('  session user:', me.body?.me?.username ?? 'GUEST');
+const bootPeople = me.body?.people || [];
+const bootHas = n => bootPeople.some(p => p.username?.toLowerCase() === n);
+check('bootstrap people includes priya.verma (mention will link)', bootHas('priya.verma'), `people=${bootPeople.length}`);
+check('ghost.nobody is not a profile (stays plain text)', !bootHas('ghost.nobody'));
+
+// 1. ?person takes a profile id — seeded demo profile resolves
+const anaya = await get('/api/social?person=demo_anaya');
+check('?person=demo_anaya resolves', anaya.status === 200 && anaya.body?.id === 'demo_anaya', JSON.stringify(anaya.body)?.slice(0, 100));
+const prof = await get('/api/social?profile=demo_anaya');
+const coast = prof.body.find(p => p.id === 'demo_coast');
+check('found seeded coast post via ?profile', !!coast, coast?.caption?.slice(0, 40));
+
+// 2. seeded hashtag queries (read-only)
+const travel = await get('/api/social?hashtag=travel');
+check('?hashtag=travel returns coast post (seeded)', travel.status === 200 && travel.body.posts.some(p => p.id === 'demo_coast'), `${travel.body?.posts.length} post(s)`);
+const trav = await get('/api/social?hashtag=trav');
+check('?hashtag=trav matches nothing (whole-word)', trav.status === 200 && trav.body.posts.length === 0, `${trav.body?.posts.length} post(s)`);
+const italy = await get('/api/social?hashtag=italy');
+check('?hashtag=italy returns exactly the coast post', italy.status === 200 && italy.body.posts.length === 1 && italy.body.posts[0].id === 'demo_coast', `${italy.body?.posts.length} post(s)`);
+check('hashtag shape hasMore', italy.status === 200 && italy.body.hasMore === false);
+const TRAVEL = await get('/api/social?hashtag=TRAVEL');
+check('?hashtag=TRAVEL also matches (case-insensitive)', TRAVEL.status === 200 && TRAVEL.body.posts.some(p => p.id === 'demo_coast'));
+// reels are part of hashtag results; stories are not
+const nature = await get('/api/social?hashtag=nature');
+const natureReel = nature.body?.posts?.find(p => p.media_type === 'video');
+check('?hashtag=nature includes the video reel', nature.status === 200 && !!natureReel, `posts=${nature.body?.posts?.length}, reel=${!!natureReel}`);
+check('no stories in hashtag results', (nature.body?.posts || []).filter(p => p.kind === 'story').length === 0);
+// validation
+const bad1 = await get('/api/social?hashtag=');
+const bad2 = await get('/api/social?hashtag=bad!!');
+const bad3 = await get('/api/social?hashtag=' + 'a'.repeat(51));
+check('empty hashtag → 400', bad1.status === 400, `status=${bad1.status} ${bad1.body?.message || bad1.body?.error || ''}`);
+check('bad chars hashtag → 400', bad2.status === 400, `status=${bad2.status}`);
+check('overlong hashtag → 400', bad3.status === 400, `status=${bad3.status}`);
+// guests may browse hashtag pages (public discovery, like ?explore/?search);
+// the privacy guard still hides private accounts from them. Personal endpoints
+// (e.g. ?following) remain 401 for guests.
+const guest = await fetch(BASE + '/api/social?hashtag=travel');
+const gBody = await guest.json().catch(() => null);
+check('guest can browse hashtag page (public discovery)', guest.status === 200 && Array.isArray(gBody?.posts), `status=${guest.status} posts=${gBody?.posts?.length}`);
+const guestFollow = await fetch(BASE + '/api/social?following=1');
+check('guest ?following still → 401 (personal)', guestFollow.status === 401, `status=${guestFollow.status}`);
+
+// 3. upload media as you.preview, create post with @mention + #tag
+const key = crypto.randomUUID();
+const img = readFileSync('public/media/avatar-1.jpg');
+const form = new FormData();
+form.append('key', key);
+form.append('file', new File([img], 'avatar-1.jpg', { type: 'image/jpeg' }));
+const up = await fetch(BASE + '/api/dev-upload', { method: 'POST', headers: H, body: form }).then(async r => ({ status: r.status, body: await r.json().catch(() => null) }));
+check('dev-upload as you.preview', up.status === 200 && up.body?.url, JSON.stringify(up.body)?.slice(0, 80));
+const NEW = 'Testing @priya.verma and #smoketest99 from the other side ☀️';
+const created = await post({ action: 'create_post', kind: 'post', caption: NEW, media: [up.body.url], category: 'Travel' });
+check('create_post with mention+tag', created.status === 200 && !!created.body?.id, JSON.stringify(created.body)?.slice(0, 80));
+const myId = created.body?.id;
+const smoketest = await get('/api/social?hashtag=smoketest99');
+check('?hashtag=smoketest99 finds the new post', smoketest.status === 200 && smoketest.body.posts.some(p => p.id === myId), `${smoketest.body?.posts.length} post(s)`);
+const one = await get('/api/social?post=' + myId);
+check('?post returns the caption', (one.body?.[0]?.caption || '') === NEW, (one.body?.[0]?.caption || '').slice(0, 50));
+
+// 4. unknown handle stays in the caption verbatim (client renders plain text)
+const upd = await post({ action: 'update_post', id: myId, caption: NEW + ' @ghost.nobody', category: 'Travel' });
+check('update with unknown handle ok', upd.status === 200 && upd.body?.ok);
+const one2 = await get('/api/social?post=' + myId);
+check('unknown handle kept in caption verbatim', (one2.body?.[0]?.caption || '').includes('@ghost.nobody'));
+
+// 5. cleanup
+const del = await post({ action: 'delete_post', id: myId });
+check('delete test post', del.status === 200 && del.body?.ok);
+const after = await get('/api/social?hashtag=smoketest99');
+check('smoketest99 gone after delete', after.status === 200 && after.body.posts.length === 0, `${after.body?.posts.length} post(s)`);
+
+console.log(fails ? `\n${fails} FAILURE(S)` : '\nALL PASS');
+process.exit(fails ? 1 : 0);
