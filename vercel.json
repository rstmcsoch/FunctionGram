{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "functions": {
    "app/api/**/route.ts": {
      "maxDuration": 60
    }
  },
  "regions": ["bom1"],
  "crons": [
    { "path": "/api/cron/verification", "schedule": "19 8 * * *" },
    { "path": "/api/cron/warm", "schedule": "0 3 * * *" }
  ]
}
