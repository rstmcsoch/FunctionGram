+type Rate={page:number;total:number;hits:number;items:{client:string;path:string;count:number;lastRequest:number;clientToken:string}[]};
+type Account={shadow_banned:boolean;comment_banned:boolean;shadow_reason:string;comment_reason:string;updated_at?:number;updated_by?:string};
+const reasons=['spam','harassment','false_information','misleading','inappropriate','other'];
+async function api<T=Record<string,unknown>>(path:string,body?:unknown):Promise<T>{const response=await fetch(path,body?{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)}:undefined);const data=await response.json() as T&{error?:string};if(!response.ok)throw new Error(data.error||'Request failed.');return data;}
+const ago=(time:number)=>new Date(time).toLocaleString();
