+ const loadAccount=async(id:string)=>{const result=await api<Account>('/api/admin/moderation?view=account&id='+encodeURIComponent(id));setAccount(result);setAccountReason(result.shadow_reason||result.comment_reason||'');};
+ const saveNotes=(report:Report,notes:string)=>mutate(async()=>{await api('/api/admin/moderation',{action:'updateReport',operation:'notes',id:report.id,notes});await reloadReports();});
+ const act=(report:Report,action:string,reason:string)=>mutate(async()=>{await api('/api/admin/moderation',{op:'resolveReport',id:report.id,action,reason,notes:report.notes||''});await reloadReports();});
+ return <div className="moderation-console">
+  <nav className="moderation-tabs" aria-label="Moderation tools">{[['all','Reports'],['filters','Word & domain filters'],['accounts','Account safety'],['rates','Rate limits']].map(([key,label])=><button key={key} className="admin-button" aria-pressed={view===key} onClick={()=>setView(key)}>{label}</button>)}</nav>
+  {message&&<p role="status">{message}</p>}
+  {view==='all'&&<section className="admin-card admin-confirm"><h2>Reports inbox</h2><p>New {reports.counts.new||0} · Triage {reports.counts.triage||0} · Actioned {reports.counts.actioned||0} · Dismissed {reports.counts.dismissed||0} · {reports.total} matching this page&apos;s filters.</p>
+   <form className="moderation-filters" onSubmit={event=>{event.preventDefault();void reloadReports({...reports.filter,page:1});}}><label>Status<select value={reports.filter.status} onChange={e=>setReports({...reports,filter:{...reports.filter,status:e.target.value}})}>{['new','triage','actioned','dismissed','all'].map(x=><option key={x}>{x}</option>)}</select></label><label>Reason<select value={reports.filter.reason} onChange={e=>setReports({...reports,filter:{...reports.filter,reason:e.target.value}})}><option value="">All reasons</option>{reasons.map(x=><option key={x}>{x}</option>)}</select></label><label>Target<select value={reports.filter.target} onChange={e=>setReports({...reports,filter:{...reports.filter,target:e.target.value}})}><option value="all">All targets</option><option value="post">Posts</option><option value="profile">Profiles</option></select></label><label>Search ID or username<input value={reports.filter.q} maxLength={100} onChange={e=>setReports({...reports,filter:{...reports.filter,q:e.target.value}})}/></label><button className="admin-button admin-primary">Apply filters</button></form>
+   {!reports.items.length&&<p>No reports match the current filters.</p>}
+   <div className="moderation-report-list">{reports.items.map(report=><ReportCard key={report.id} report={report} busy={busy} actorId={actorId} onAssign={()=>void mutate(async()=>{await api('/api/admin/moderation',{action:'updateReport',operation:'assign',id:report.id});await reloadReports();})} onSaveNotes={notes=>saveNotes(report,notes)} onAction={(action,reason)=>act(report,action,reason)} onLoadAccount={id=>{setAccountId(id);setView('accounts');}}/>)}</div>
+   <div className="admin-pagination"><button className="admin-button" disabled={reports.filter.page<=1} onClick={()=>void reloadReports({...reports.filter,page:reports.filter.page-1})}>Previous</button><span>Page {reports.filter.page} · up to 50 reports</span><button className="admin-button" disabled={reports.items.length<50} onClick={()=>void reloadReports({...reports.filter,page:reports.filter.page+1})}>Next</button></div>
+  </section>}
+  {view==='filters'&&<section className="admin-card admin-confirm"><h2>Word &amp; domain filters</h2><p>Rules are checked on the server for new captions, edited captions, comments and messages. Existing posts remain unchanged. Plain words match whole tokens; domains match exact hosts and their subdomains. Regexes are deliberately restricted to a safe subset.</p>
