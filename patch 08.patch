+ const [reports,setReports]=useState(initialReports),[config,setConfig]=useState(initialConfig),[rates,setRates]=useState(initialRates),[view,setView]=useState('all'),[text,setText]=useState(''),[preview,setPreview]=useState(''),[busy,setBusy]=useState(false),[message,setMessage]=useState(''),[accountId,setAccountId]=useState(''),[account,setAccount]=useState<Account|null>(null),[accountReason,setAccountReason]=useState(''),[accountConfirm,setAccountConfirm]=useState(''),[page,setPage]=useState(1);
+ const mutate=async(work:()=>Promise<void>)=>{setBusy(true);setMessage('');try{await work();setMessage('Saved and audited.');}catch(error){setMessage(error instanceof Error?error.message:'Request failed.');}finally{setBusy(false);}};
+ const reloadReports=async(filters=reports.filter)=>{const q=new URLSearchParams(Object.entries(filters).map(([key,value])=>[key,String(value)]));setReports(await api('/api/admin/moderation?'+q));};
