# Production database: Turso/libSQL.
# TURSO_DATABASE_URL is the libSQL URL (libsql://… for a Turso database, or
# file:… for a local database file). TURSO_AUTH_TOKEN is only needed for a
# remote Turso database. Without TURSO_DATABASE_URL the server refuses to
# serve: there is no PostgreSQL runtime any more.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Legacy local-development fallback. When no TURSO_DATABASE_URL is set and
# NODE_ENV is not production, the app falls back to an embedded PGlite
# database so `next dev` works without any credentials. Production and the
# test suite never use this.
FUNCTIONGRAM_PGLITE_DIR=

BLOB_READ_WRITE_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional exact origins for additional domains, tunnels, or preview hosts
# (comma-separated). Wildcards are never accepted, and Vercel requires HTTPS.
AUTH_TRUSTED_ORIGINS=

# Server-only Brevo API key (not an SMTP key) and a sender verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RSTMC

# Optional, server-only. Verified existing account to promote ONCE to admin.
# Unset disables bootstrap. Remove after promotion; never put a password here.
ADMIN_BOOTSTRAP_EMAIL=

# Optional comma-separated IPv4/IPv6 addresses or CIDRs for admin pages and APIs.
# Leave empty to disable; do not guess or set an owner IP before deployment.
ADMIN_IP_ALLOWLIST=
