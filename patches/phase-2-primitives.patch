+.admin-drawer[open] > summary::after { transform: rotate(180deg); }
+.admin-drawer > div { padding: 20px 24px 24px; border-top: 1px solid var(--adm-border-subtle); }
+
+/* ---------- 8.14 Code, IDs, JSON ---------- */
+
+.admin-shell code, .admin-confirm code {
+  padding: 2px 6px; border-radius: 6px; background: var(--adm-muted-surface);
