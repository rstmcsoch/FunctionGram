+}
+.admin-shell pre, .admin-confirm pre {
+  max-height: 320px; overflow: auto; margin: 8px 0; padding: 16px;
+  border: 1px solid var(--adm-border-subtle); border-radius: 10px; background: var(--adm-muted-surface);
+  font-family: var(--adm-mono); font-size: 12px; line-height: 18px;
+  white-space: pre-wrap; overflow-wrap: anywhere; color: var(--adm-text);
+}
+.admin-shell pre code, .admin-confirm pre code { padding: 0; background: none; }
+
+/* ---------- 8.15 Detail pages ---------- */
+
+.admin-detail { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; align-items: start; }
+.admin-detail > * { margin-top: 0; }
+.admin-detail dl { display: grid; gap: 0; margin: 0; }
+.admin-detail dt { padding: 12px 140px 12px 0; color: var(--adm-text-2); font-size: 13px; line-height: 20px; }
+.admin-detail dd { margin: 0; padding: 12px 0; border-bottom: 1px solid var(--adm-border-subtle); color: var(--adm-text); font-size: 14px; line-height: 20px; overflow-wrap: anywhere; }
+.admin-detail dd:last-of-type { border-bottom: 0; }
+.admin-detail > div > dl > div, .admin-definition-list > div { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
+.admin-definition-list { display: grid; margin: 0; }
+.admin-definition-list dt { padding: 12px 0; color: var(--adm-text-2); font-size: 13px; line-height: 20px; }
+.admin-definition-list dd { margin: 0; padding: 12px 0; border-bottom: 1px solid var(--adm-border-subtle); text-align: right; overflow-wrap: anywhere; }
+@media (min-width: 1024px) {
+  .admin-detail-columns { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 20px; align-items: start; }
+}
+@media (max-width: 1023px) {
+  .admin-detail { grid-template-columns: minmax(0, 1fr); }
+  .admin-detail dt { padding-right: 16px; }
+}
+
+/* ---------- Responsive primitives ---------- */
+
+@media (max-width: 1023px) {
+  .admin-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
+  .admin-stat strong { font-size: 26px; line-height: 32px; }
+}
+@media (max-width: 479px) {
