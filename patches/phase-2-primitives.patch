+  .admin-search > label:first-of-type { grid-column: auto; }
+  .admin-search > .admin-button, .admin-search > a.admin-button { width: 100%; }
+}
+@media (max-width: 339px) {
+  .admin-stats { grid-template-columns: minmax(0, 1fr); }
+}
