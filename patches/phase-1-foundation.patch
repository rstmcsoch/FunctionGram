diff --git a/app/rstmcadmin/admin-components.css b/app/rstmcadmin/admin-components.css
new file mode 100644
index 0000000..f21db2e
--- /dev/null
+++ b/app/rstmcadmin/admin-components.css
@@ -0,0 +1,133 @@
+/* ==========================================================================
+   FunctionGram / RSTMC admin — reusable primitives
+   Phase 1 seeds the two primitives the shell account card needs (§8.5 badges,
+   §8.10 avatars). Later phases extend this file with the remaining controls.
+
+   VISUAL ONLY, scoped to `.admin-shell` (and the dialog portal, which renders
+   outside the shell subtree).
+   ========================================================================== */
+
+/* ==========================================================================
+   Avatars (§8.10)
+   ========================================================================== */
+
+.admin-shell .admin-avatar {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex: none;
+  width: 36px;
+  height: 36px;
+  border-radius: var(--adm-r-pill);
+  font-size: 13px;
+  font-weight: 600;
+  line-height: 1;
+  letter-spacing: .01em;
+  text-transform: uppercase;
+  user-select: none;
+}
+
+.admin-shell .admin-avatar[data-size="28"] {
+  width: 28px;
+  height: 28px;
+  font-size: 11px;
+}
+
+.admin-shell .admin-avatar[data-size="40"] {
+  width: 40px;
+  height: 40px;
+}
+
+.admin-shell .admin-avatar[data-size="64"] {
+  width: 64px;
+  height: 64px;
+  font-size: 20px;
+}
+
+/* Six deterministic tints: background at 16%, text at the readable variant. */
+.admin-shell .admin-avatar[data-tint="blue"] {
+  background: rgba(27, 132, 255, .16);
+  color: var(--adm-accent-text);
+}
+
+.admin-shell .admin-avatar[data-tint="green"] {
+  background: rgba(23, 198, 83, .16);
+  color: var(--adm-success-text);
+}
+
+.admin-shell .admin-avatar[data-tint="purple"] {
+  background: rgba(114, 57, 234, .16);
+  color: var(--adm-purple-text);
+}
+
+.admin-shell .admin-avatar[data-tint="amber"] {
+  background: rgba(246, 177, 0, .16);
+  color: var(--adm-warning-text);
+}
+
+.admin-shell .admin-avatar[data-tint="red"] {
+  background: rgba(248, 40, 90, .16);
+  color: var(--adm-danger-text);
+}
+
+.admin-shell .admin-avatar[data-tint="cyan"] {
+  background: rgba(6, 182, 212, .16);
+  color: var(--adm-cyan-text);
+}
+
+/* ==========================================================================
+   Badges (§8.5)
+   ========================================================================== */
+
+.admin-shell .admin-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  height: 24px;
+  padding: 0 10px;
+  border-radius: var(--adm-r-pill);
+  font-size: 12px;
+  line-height: 16px;
+  font-weight: 500;
+  white-space: nowrap;
+  vertical-align: middle;
+}
+
+.admin-shell .admin-badge-dot {
+  width: 6px;
+  height: 6px;
+  flex: none;
+  border-radius: var(--adm-r-pill);
+  background: currentColor;
+}
+
+.admin-shell .admin-badge[data-tone="neutral"] {
+  background: var(--adm-muted-surface);
+  color: var(--adm-text-2);
+  box-shadow: inset 0 0 0 1px var(--adm-border-subtle);
+}
+
+.admin-shell .admin-badge[data-tone="primary"] {
+  background: var(--adm-accent-soft);
+  color: var(--adm-accent-text);
+}
+
+.admin-shell .admin-badge[data-tone="purple"] {
+  background: rgba(114, 57, 234, .14);
+  color: var(--adm-purple-text);
+}
+
+.admin-shell .admin-badge[data-tone="warning"] {
+  background: rgba(246, 177, 0, .14);
+  color: var(--adm-warning-text);
+}
+
+.admin-shell .admin-badge[data-tone="success"] {
+  background: rgba(23, 198, 83, .14);
+  color: var(--adm-success-text);
+}
+
+.admin-shell .admin-badge[data-tone="danger"] {
+  background: rgba(248, 40, 90, .14);
+  color: var(--adm-danger-text);
+}
diff --git a/app/rstmcadmin/admin-shell.css b/app/rstmcadmin/admin-shell.css
new file mode 100644
index 0000000..1d4a19c
--- /dev/null
+++ b/app/rstmcadmin/admin-shell.css
@@ -0,0 +1,546 @@
+/* ==========================================================================
+   FunctionGram / RSTMC admin — application shell
+   Redesign guide §6 (shell), §7 (responsive), §10.3/10.4 (active bar, glass).
+
+   VISUAL ONLY. The grid layout is scoped to `.admin-shell.admin-layout` so the
+   standalone two-factor screens, which reuse `.admin-shell` for tokens only,
+   keep their centred single-column presentation.
+   ========================================================================== */
+
+.admin-shell.admin-layout {
+  display: grid;
+  grid-template-columns: 272px minmax(0, 1fr);
+  height: 100dvh;
+  min-height: 100dvh;
+  padding: 0;
+  background: var(--adm-bg);
+  color: var(--adm-text);
+  overflow: hidden;
+}
+
+/* ==========================================================================
+   Sidebar (§6.2)
+   ========================================================================== */
+
+.admin-sidebar {
+  display: flex;
+  flex-direction: column;
+  gap: var(--adm-s2);
+  height: 100dvh;
+  min-width: 0;
+  padding: var(--adm-s4);
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  background: var(--adm-bg);
+}
+
+/* Brand row. */
+.admin-brand {
+  display: flex;
+  align-items: center;
+  height: 64px;
+  padding: var(--adm-s2) var(--adm-s3);
+  font-size: 22px;
+  font-weight: 700;
+  letter-spacing: -.02em;
+  color: var(--adm-text);
+  white-space: nowrap;
+}
+
+.admin-brand span {
+  color: var(--adm-brand-dot);
+}
+
+/* Navigation. */
+.admin-nav {
+  display: flex;
+  flex-direction: column;
+  gap: var(--adm-s3);
+  flex: 1 1 auto;
+  min-height: 0;
+}
+
+.admin-nav-group {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+
+.admin-nav-group-label {
+  padding: var(--adm-s4) var(--adm-s3) 6px;
+  font-size: 11px;
+  line-height: 16px;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: .08em;
+  color: var(--adm-text-3);
+}
+
+.admin-nav-link {
+  position: relative;
+  display: flex;
+  align-items: center;
+  gap: var(--adm-s3);
+  min-height: 44px;
+  padding: 0 var(--adm-s3);
+  border-radius: var(--adm-r-control);
+  font-size: 14px;
+  font-weight: 500;
+  color: var(--adm-text-2);
+  text-decoration: none;
+  transition: background-color var(--adm-dur) ease-out, color var(--adm-dur) ease-out;
+}
+
+.admin-nav-link svg {
+  flex: none;
+  width: 18px;
+  height: 18px;
+  color: var(--adm-text-3);
+  transition: color var(--adm-dur) ease-out;
+}
+
+.admin-nav-label {
+  flex: 1 1 auto;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.admin-nav-link:hover {
+  background: var(--adm-hover);
+  color: var(--adm-text);
+  text-decoration: none;
+}
+
+.admin-nav-link:hover svg {
+  color: var(--adm-text-2);
+}
+
+.admin-nav-link[aria-current="page"] {
+  background: var(--adm-active-bg);
+  color: var(--adm-accent-text);
+  font-weight: 600;
+}
+
+.admin-nav-link[aria-current="page"] svg {
+  color: var(--adm-accent-text);
+}
+
+/* §10.3 — 3x18 accent bar on the active item. */
+.admin-nav-link[aria-current="page"]::before {
+  content: "";
+  position: absolute;
+  left: 0;
+  top: 50%;
+  width: 3px;
+  height: 18px;
+  margin-top: -9px;
+  border-radius: 2px;
+  background: var(--adm-accent);
+}
+
+.admin-nav-external {
+  flex: none;
+  margin-left: auto;
+}
+
+/* Account card (§6.2) — display only, never interactive. */
+.admin-account {
+  display: flex;
+  align-items: center;
+  gap: var(--adm-s3);
+  margin-top: auto;
+  padding: var(--adm-s3);
+  border: 1px solid var(--adm-border-subtle);
+  border-radius: 12px;
+  background: var(--adm-muted-surface);
+}
+
+.admin-account-body {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  min-width: 0;
+}
+
+.admin-account-email {
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--adm-text);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* ==========================================================================
+   Panel (§6.1)
+   ========================================================================== */
+
+.admin-panel {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  margin: var(--adm-s4) var(--adm-s4) var(--adm-s4) 0;
+  border: 1px solid var(--adm-border);
+  border-radius: var(--adm-r-panel);
+  background: var(--adm-panel);
+  min-height: calc(100dvh - 32px);
+  max-height: calc(100dvh - 32px);
+  overflow-y: auto;
+  overscroll-behavior: contain;
+}
+
+/* Main area (§6.4). */
+.admin-shell .admin-main {
+  display: flex;
+  flex-direction: column;
+  gap: var(--adm-s5);
+  flex: 1 1 auto;
+  width: 100%;
+  max-width: 1360px;
+  margin: 0 auto;
+  padding: var(--adm-s6) var(--adm-s7) var(--adm-s8);
+  min-width: 0;
+}
+
+/* Page head (§6.3). Bleeds out of the main padding so the sticky glass bar
+   spans the panel, while the content below stays centred. */
+.admin-page-head {
+  position: sticky;
+  top: env(safe-area-inset-top, 0px);
+  z-index: 20;
+  display: flex;
+  flex-direction: column;
+  gap: var(--adm-s2);
+  margin: calc(var(--adm-s6) * -1) calc(var(--adm-s7) * -1) 0;
+  padding: var(--adm-s6) var(--adm-s7) var(--adm-s4);
+  border-bottom: 1px solid var(--adm-border-subtle);
+  background: color-mix(in srgb, var(--adm-panel) 85%, transparent);
+  backdrop-filter: blur(12px);
+  -webkit-backdrop-filter: blur(12px);
+}
+
+/* Browsers without color-mix keep a solid, readable bar. */
+@supports not (background: color-mix(in srgb, red 85%, transparent)) {
+  .admin-page-head {
+    background: var(--adm-panel);
+  }
+}
+
+.admin-page-head-row {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--adm-s3) var(--adm-s4);
+}
+
+.admin-page-head-title {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+}
+
+.admin-page-head-actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--adm-s2);
+}
+
+.admin-page-intro {
+  max-width: 68ch;
+  margin: 0;
+  font-size: 14px;
+  line-height: 22px;
+  color: var(--adm-text-2);
+}
+
+/* Title and breadcrumb share one baseline row on desktop. */
+@media (min-width: 1024px) {
+  .admin-page-head-title {
+    flex-direction: row;
+    align-items: baseline;
+    gap: var(--adm-s4);
+  }
+}
+
+/* Footer (§6.5). */
+.admin-footer {
+  padding: var(--adm-s5) var(--adm-s7);
+  border-top: 1px solid var(--adm-border-subtle);
+}
+
+.admin-footer p {
+  margin: 0;
+  font-size: 12px;
+  line-height: 16px;
+  color: var(--adm-text-3);
+}
+
+/* ==========================================================================
+   Mobile top bar and drawer (§7) — hidden at >= 768px
+   ========================================================================== */
+
+.admin-topbar,
+.admin-backdrop {
+  display: none;
+}
+
+/* ==========================================================================
+   Responsive (§7)
+   ========================================================================== */
+
+/* 1024–1279 — narrower labelled sidebar. */
+@media (max-width: 1279px) {
+  .admin-shell.admin-layout {
+    grid-template-columns: 240px minmax(0, 1fr);
+  }
+}
+
+/* 768–1023 — 76px icon rail; labels stay in the DOM but are hidden. */
+@media (max-width: 1023px) {
+  .admin-shell.admin-layout {
+    grid-template-columns: 76px minmax(0, 1fr);
+  }
+
+  .admin-sidebar {
+    padding: var(--adm-s3) var(--adm-s2);
+    align-items: stretch;
+  }
+
+  .admin-brand {
+    justify-content: center;
+    padding: var(--adm-s2) 0;
+    font-size: 18px;
+  }
+
+  .admin-nav-link {
+    justify-content: center;
+    padding: 0;
+  }
+
+  .admin-nav-label,
+  .admin-nav-external {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    padding: 0;
+    margin: -1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    clip-path: inset(50%);
+    white-space: nowrap;
+    border: 0;
+  }
+
+  /* Group labels become thin dividers. */
+  .admin-nav-group-label {
+    height: 1px;
+    padding: 0;
+    margin: var(--adm-s3) var(--adm-s2) var(--adm-s2);
+    overflow: hidden;
+    text-indent: -999em;
+    background: var(--adm-border-subtle);
+  }
+
+  .admin-account {
+    justify-content: center;
+    padding: var(--adm-s2);
+  }
+
+  .admin-account-body {
+    display: none;
+  }
+
+  /* Panel is full-bleed below 1024 (§6.1). */
+  .admin-panel {
+    margin: 0;
+    border: 0;
+    border-radius: 0;
+    min-height: 100dvh;
+    max-height: 100dvh;
+  }
+}
+
+/* < 768 — sticky top bar plus slide-in drawer. */
+@media (max-width: 767px) {
+  .admin-shell.admin-layout {
+    display: block;
+    height: auto;
+    min-height: 100dvh;
+    overflow: visible;
+  }
+
+  .admin-topbar {
+    position: sticky;
+    top: 0;
+    z-index: 40;
+    display: flex;
+    align-items: center;
+    gap: var(--adm-s2);
+    height: calc(56px + env(safe-area-inset-top, 0px));
+    padding: env(safe-area-inset-top, 0px) var(--adm-s2) 0;
+    border-bottom: 1px solid var(--adm-border);
+    background: var(--adm-bg);
+  }
+
+  .admin-topbar-button {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    width: 44px;
+    height: 44px;
+    flex: none;
+    padding: 0;
+    border: 0;
+    border-radius: var(--adm-r-control);
+    background: transparent;
+    color: var(--adm-text);
+    cursor: pointer;
+  }
+
+  .admin-topbar-button:hover {
+    background: var(--adm-hover);
+  }
+
+  .admin-topbar .admin-brand {
+    height: auto;
+    padding: 0 var(--adm-s1);
+    font-size: 20px;
+  }
+
+  /* The sidebar becomes the drawer. Same nav, never duplicated in the DOM. */
+  .admin-sidebar {
+    position: fixed;
+    inset: 0 auto 0 0;
+    z-index: 60;
+    width: min(296px, 86vw);
+    height: 100dvh;
+    padding: var(--adm-s4);
+    border-right: 1px solid var(--adm-border);
+    background: var(--adm-bg);
+    transform: translateX(-100%);
+    visibility: hidden;
+    transition: transform var(--adm-dur-lg) var(--adm-ease), visibility 0s linear var(--adm-dur-lg);
+  }
+
+  .admin-sidebar[data-open="true"] {
+    transform: translateX(0);
+    visibility: visible;
+    transition: transform var(--adm-dur-lg) var(--adm-ease), visibility 0s;
+  }
+
+  .admin-backdrop {
+    position: fixed;
+    inset: 0;
+    z-index: 50;
+    display: block;
+    border: 0;
+    padding: 0;
+    background: rgba(0, 0, 0, .55);
+    backdrop-filter: blur(2px);
+    -webkit-backdrop-filter: blur(2px);
+    opacity: 0;
+    visibility: hidden;
+    transition: opacity var(--adm-dur-lg) var(--adm-ease), visibility 0s linear var(--adm-dur-lg);
+  }
+
+  .admin-backdrop[data-open="true"] {
+    opacity: 1;
+    visibility: visible;
+    transition: opacity var(--adm-dur-lg) var(--adm-ease), visibility 0s;
+  }
+
+  /* Rail overrides from the 1023 breakpoint are reverted inside the drawer. */
+  .admin-sidebar .admin-brand {
+    justify-content: flex-start;
+    height: 56px;
+    padding: var(--adm-s2) var(--adm-s3);
+    font-size: 22px;
+  }
+
+  .admin-nav-link {
+    justify-content: flex-start;
+    padding: 0 var(--adm-s3);
+  }
+
+  .admin-nav-label,
+  .admin-nav-external {
+    position: static;
+    width: auto;
+    height: auto;
+    margin: 0;
+    overflow: visible;
+    clip: auto;
+    clip-path: none;
+  }
+
+  .admin-nav-label {
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+
+  .admin-nav-external {
+    margin-left: auto;
+  }
+
+  .admin-nav-group-label {
+    height: auto;
+    padding: var(--adm-s4) var(--adm-s3) 6px;
+    margin: 0;
+    overflow: visible;
+    text-indent: 0;
+    background: none;
+  }
+
+  .admin-account {
+    justify-content: flex-start;
+    padding: var(--adm-s3);
+  }
+
+  .admin-account-body {
+    display: flex;
+  }
+
+  .admin-panel {
+    margin: 0;
+    border: 0;
+    border-radius: 0;
+    min-height: 0;
+    max-height: none;
+    overflow: visible;
+  }
+
+  .admin-shell .admin-main {
+    padding: var(--adm-s4) var(--adm-s4) var(--adm-s6);
+    gap: var(--adm-s4);
+  }
+
+  /* Not sticky on mobile — it would eat the screen (§6.3). */
+  .admin-page-head {
+    position: static;
+    margin: calc(var(--adm-s4) * -1) calc(var(--adm-s4) * -1) 0;
+    padding: var(--adm-s4) var(--adm-s4) var(--adm-s3);
+    background: var(--adm-panel);
+    backdrop-filter: none;
+    -webkit-backdrop-filter: none;
+  }
+
+  .admin-footer {
+    padding: var(--adm-s5) var(--adm-s4);
+  }
+}
+
+/* Page-level sideways scroll is never acceptable (§1.4, §7). */
+.admin-shell.admin-layout,
+.admin-panel,
+.admin-shell .admin-main {
+  max-width: 100%;
+}
+
+.admin-shell .admin-main > * {
+  min-width: 0;
+}
diff --git a/app/rstmcadmin/admin-tokens.css b/app/rstmcadmin/admin-tokens.css
new file mode 100644
index 0000000..3d4efdc
--- /dev/null
+++ b/app/rstmcadmin/admin-tokens.css
@@ -0,0 +1,343 @@
+/* ==========================================================================
+   FunctionGram / RSTMC admin — design tokens and typography
+   Redesign guide §4 (tokens), §5 (typography), §10 (touches), §11 (motion/a11y).
+
+   VISUAL ONLY. Everything is scoped to `.admin-shell`; no public-site token,
+   `app/globals.css` value or component behaviour is touched.
+
+   Theme switching mirrors the selectors the app already emits from
+   `appearanceCss()` in `lib/appearance.ts`:
+     html:root{...}                       -> light
+     html:root[data-theme="dark"]{...}    -> explicit dark
+     @media(prefers-color-scheme:dark){html:root:not([data-theme]){...}}
+   A `.dark` class is honoured too, in case a later theme provider sets one.
+   ========================================================================== */
+
+.admin-shell {
+  /* ---- Accent. Change ONLY this block to re-brand (brand pink = #eb456e) -- */
+  --adm-accent: #1b84ff;
+  --adm-accent-hover: #0f6fe0;
+  --adm-accent-soft: rgba(27, 132, 255, .14);
+  --adm-on-accent: #fff;
+
+  /* ---- Status tones ---------------------------------------------------- */
+  --adm-success: #17c653;
+  --adm-warning: #f6b100;
+  --adm-danger: #f8285a;
+  --adm-purple: #7239ea;
+  --adm-cyan: #06b6d4;
+
+  /* ---- Shape ----------------------------------------------------------- */
+  --adm-r-panel: 20px;
+  --adm-r-card: 14px;
+  --adm-r-control: 10px;
+  --adm-r-pill: 999px;
+
+  /* ---- Type -----------------------------------------------------------
+     Inter first, then a full system stack. The guide asks for `next/font`,
+     but the panel must stay readable and correctly proportioned when Inter
+     is unavailable, so every size below is tuned against this stack.       */
+  --adm-font: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  --adm-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+
+  /* ---- Motion ---------------------------------------------------------- */
+  --adm-ease: cubic-bezier(.2, .8, .2, 1);
+  --adm-dur: 150ms;
+  --adm-dur-lg: 240ms;
+
+  /* ---- Spacing scale (4px base) ---------------------------------------- */
+  --adm-s1: 4px;
+  --adm-s2: 8px;
+  --adm-s3: 12px;
+  --adm-s4: 16px;
+  --adm-s5: 20px;
+  --adm-s6: 24px;
+  --adm-s7: 28px;
+  --adm-s8: 32px;
+  --adm-s9: 48px;
+
+  /* The single remaining piece of brand pink: the wordmark dot (§6.2). */
+  --adm-brand-dot: #eb456e;
+}
+
+/* ---- LIGHT (base) -------------------------------------------------------- */
+.admin-shell {
+  color-scheme: light;
+  --adm-bg: #f3f4f6;
+  --adm-panel: #fff;
+  --adm-card: #fff;
+  --adm-muted-surface: #f7f8fa;
+  --adm-hover: #f1f3f6;
+  --adm-border: #e4e6eb;
+  --adm-border-subtle: #eceef2;
+  --adm-text: #15161a;
+  --adm-text-2: #5b606c;
+  --adm-text-3: #8a8f9b;
+  --adm-accent-text: #0f63d6;           /* passes AA on white */
+  --adm-active-bg: var(--adm-accent-soft);
+  --adm-shadow: 0 1px 2px rgba(16, 24, 40, .06);
+  --adm-success-text: #0d8a3c;
+  --adm-warning-text: #a15c07;
+  --adm-danger-text: #d61f4c;
+  --adm-purple-text: #6234c7;
+  --adm-cyan-text: #0e7490;             /* companion to --adm-cyan (§9.1) */
+  --adm-dialog-shadow: 0 24px 64px rgba(16, 24, 40, .24);
+}
+
+/* ---- DARK (default look, matches the reference) -------------------------- */
+html[data-theme="dark"] .admin-shell,
+.dark .admin-shell {
+  color-scheme: dark;
+  --adm-bg: #0f0f12;                    /* page + sidebar */
+  --adm-panel: #08080a;                 /* main panel */
+  --adm-card: #0c0c0f;
+  --adm-muted-surface: #131317;         /* table header, chips, code */
+  --adm-hover: #17171c;
+  --adm-border: #222228;
+  --adm-border-subtle: #1a1a1f;
+  --adm-text: #f5f5f7;
+  --adm-text-2: #a1a1aa;                /* secondary */
+  --adm-text-3: #71717a;                /* hints */
+  --adm-accent-text: #4da3ff;           /* links + active nav text */
+  --adm-active-bg: #000;
+  --adm-shadow: 0 1px 2px rgba(0, 0, 0, .4);
+  --adm-success-text: #3ddc84;
+  --adm-warning-text: #ffc933;
+  --adm-danger-text: #ff5c85;
+  --adm-purple-text: #a78bfa;
+  --adm-cyan-text: #45d0e8;
+  --adm-dialog-shadow: 0 24px 64px rgba(0, 0, 0, .5);
+}
+
+@media (prefers-color-scheme: dark) {
+  html:not([data-theme]) .admin-shell {
+    color-scheme: dark;
+    --adm-bg: #0f0f12;
+    --adm-panel: #08080a;
+    --adm-card: #0c0c0f;
+    --adm-muted-surface: #131317;
+    --adm-hover: #17171c;
+    --adm-border: #222228;
+    --adm-border-subtle: #1a1a1f;
+    --adm-text: #f5f5f7;
+    --adm-text-2: #a1a1aa;
+    --adm-text-3: #71717a;
+    --adm-accent-text: #4da3ff;
+    --adm-active-bg: #000;
+    --adm-shadow: 0 1px 2px rgba(0, 0, 0, .4);
+    --adm-success-text: #3ddc84;
+    --adm-warning-text: #ffc933;
+    --adm-danger-text: #ff5c85;
+    --adm-purple-text: #a78bfa;
+    --adm-cyan-text: #45d0e8;
+    --adm-dialog-shadow: 0 24px 64px rgba(0, 0, 0, .5);
+  }
+}
+
+/* ==========================================================================
+   Typography (§5)
+   ========================================================================== */
+
+.admin-shell {
+  font-family: var(--adm-font);
+  color: var(--adm-text);
+  font-size: 14px;
+  line-height: 22px;
+  -webkit-font-smoothing: antialiased;
+}
+
+.admin-shell h1 {
+  font-size: 24px;
+  line-height: 32px;
+  font-weight: 600;
+  letter-spacing: -.01em;
+  margin: 0;
+}
+
+.admin-shell h2 {
+  font-size: 16px;
+  line-height: 24px;
+  font-weight: 600;
+  margin: 0;
+}
+
+.admin-shell h3 {
+  font-size: 14px;
+  line-height: 20px;
+  font-weight: 600;
+  margin: 0;
+}
+
+.admin-shell p {
+  line-height: 22px;
+  overflow-wrap: anywhere;
+}
+
+.admin-shell small,
+.admin-shell .admin-caption {
+  font-size: 12px;
+  line-height: 16px;
+  color: var(--adm-text-3);
+}
+
+.admin-shell code,
+.admin-shell pre,
+.admin-shell kbd,
+.admin-shell samp {
+  font-family: var(--adm-mono);
+  font-size: 12px;
+  line-height: 18px;
+}
+
+.admin-shell a {
+  color: var(--adm-accent-text);
+  text-decoration: none;
+}
+
+.admin-shell a:hover,
+.admin-shell a:focus-visible {
+  text-decoration: underline;
+}
+
+/* The old eyebrow becomes the breadcrumb: normal case, no tracking, not pink. */
+.admin-shell .admin-eyebrow {
+  font-size: 13px;
+  line-height: 20px;
+  font-weight: 500;
+  letter-spacing: normal;
+  text-transform: none;
+  color: var(--adm-text-2);
+  margin: 0;
+}
+
+.admin-shell .admin-muted {
+  color: var(--adm-text-2);
+}
+
+/* Numbers line up wherever they are compared (§10.7). */
+.admin-shell .admin-stat strong,
+.admin-shell .admin-num {
+  font-variant-numeric: tabular-nums;
+}
+
+@media (max-width: 767px) {
+  .admin-shell h1 {
+    font-size: 22px;
+    line-height: 28px;
+  }
+}
+
+/* ==========================================================================
+   Shared shell affordances (§10, §11)
+   ========================================================================== */
+
+/* §10.9 — selection colour. */
+.admin-shell ::selection {
+  background: rgba(27, 132, 255, .3);
+}
+
+/* §10.11 — custom scrollbars, admin only. */
+.admin-shell *::-webkit-scrollbar {
+  width: 8px;
+  height: 8px;
+}
+
+.admin-shell *::-webkit-scrollbar-track {
+  background: transparent;
+}
+
+.admin-shell *::-webkit-scrollbar-thumb {
+  background: var(--adm-border);
+  border-radius: 4px;
+}
+
+.admin-shell *::-webkit-scrollbar-thumb:hover {
+  background: var(--adm-text-3);
+}
+
+.admin-shell * {
+  scrollbar-width: thin;
+  scrollbar-color: var(--adm-border) transparent;
+}
+
+/* §11 — focus is never removed; :focus-visible only. */
+.admin-shell :focus-visible,
+.admin-confirm-dialog :focus-visible {
+  outline: 2px solid var(--adm-accent);
+  outline-offset: 2px;
+  border-radius: 4px;
+}
+
+/* §11 — the sticky page head must not hide in-page anchor targets. */
+html:has(.admin-shell) {
+  scroll-padding-top: 96px;
+}
+
+/* §10.8 — skip link, hidden until focused, first in the DOM. */
+.admin-skip-link {
+  position: fixed;
+  top: 8px;
+  left: 8px;
+  z-index: 100;
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0 16px;
+  border-radius: var(--adm-r-control);
+  background: var(--adm-accent);
+  color: var(--adm-on-accent);
+  font-size: 14px;
+  font-weight: 500;
+  text-decoration: none;
+  transform: translateY(-200%);
+  transition: transform var(--adm-dur) ease-out;
+}
+
+.admin-skip-link:focus-visible {
+  transform: translateY(0);
+  text-decoration: none;
+}
+
+/* §10.12 — press feedback. */
+.admin-shell button:not(:disabled):active,
+.admin-shell .admin-button:not(:disabled):active {
+  transform: scale(.98);
+}
+
+/* §11 — content fade-in. */
+.admin-shell .admin-main {
+  animation: adm-rise 200ms ease-out both;
+}
+
+@keyframes adm-rise {
+  from {
+    opacity: 0;
+    transform: translateY(4px);
+  }
+
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+/* §11 — reduced motion turns everything off. */
+@media (prefers-reduced-motion: reduce) {
+
+  .admin-shell,
+  .admin-shell *,
+  .admin-shell *::before,
+  .admin-shell *::after,
+  .admin-confirm-dialog,
+  .admin-confirm-dialog * {
+    animation-duration: .001ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: .001ms !important;
+    scroll-behavior: auto !important;
+  }
+
+  .admin-shell button:not(:disabled):active,
+  .admin-shell .admin-button:not(:disabled):active {
+    transform: none;
+  }
+}
