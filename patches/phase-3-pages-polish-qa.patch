+    {banner ? <svg className="admin-banner-pattern" viewBox="0 0 260 200" aria-hidden="true" focusable="false">
+      <g fill="none" stroke="currentColor" strokeWidth="1">{hexes().map(cell => <polygon key={cell.key} points={cell.points} />)}</g>
+    </svg> : null}
