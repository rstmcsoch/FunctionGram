+.conversation:hover{background:var(--muted)}
+.conversation.selected{background:var(--accent)}
+.conversation>span:first-of-type{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px;line-height:1.35}
+.conversation strong{font-size:14px}
+.conversation small{font-size:13px;color:var(--muted-foreground);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.conversation time{font-size:12px;color:var(--muted-foreground);flex-shrink:0}
+.unread-badge{font-size:11.5px;font-weight:650;color:#fff;background:var(--primary);border-radius:50%;min-width:19px;height:19px;display:flex;align-items:center;justify-content:center;padding:0 5px;flex-shrink:0}
+.no-results{font-size:13.5px;color:var(--muted-foreground);padding:10px 8px}
+.messages-note{font-size:12px;color:var(--muted-foreground);line-height:1.6;padding:12px 8px 4px}
+.chat-panel{display:flex;flex-direction:column;min-height:0}
+.chat-panel>header{display:flex;align-items:center;gap:11px;padding:18px 14px;border-bottom:1px solid var(--border)}
+.chat-panel>header>button{display:flex;flex-direction:column;line-height:1.35;min-width:0;text-align:left}
+.chat-panel>header strong{font-size:14.5px}
+.chat-panel>header span{font-size:12.5px;color:var(--muted-foreground)}
+.chat-back{display:none}
+.chat-content{flex:1 1 auto;min-height:0;overflow-y:auto;padding:20px 16px;display:flex;flex-direction:column;gap:4px;overscroll-behavior:contain}
+.message-row{display:flex;flex-direction:column;max-width:72%;margin-bottom:9px;animation:view-in var(--motion) var(--ease)}
+.message-row p{padding:10px 14px;border-radius:20px;font-size:14.5px;line-height:1.5;overflow-wrap:anywhere;white-space:pre-wrap}
+.message-row time{font-size:11px;color:var(--muted-foreground);padding:2px 8px}
+.message-row.outgoing{align-self:flex-end;align-items:flex-end}
+.message-row.outgoing p{background:var(--primary);color:#fff;border-bottom-right-radius:7px}
+.message-row.incoming{align-self:flex-start;align-items:flex-start}
+.message-row.incoming p{background:var(--muted);border-bottom-left-radius:7px}
+.message-row.sending{opacity:.55}
+.message-link{text-decoration:underline;text-underline-offset:3px}
+.message-compose{display:flex;align-items:center;gap:8px;margin:12px 14px 16px;padding:4px 6px 4px 10px;border:1px solid var(--input);border-radius:26px;background:var(--background);transition:border-color var(--motion-fast)}
+.message-compose:focus-within{border-color:var(--ring)}
+.message-compose input{flex:1;min-width:0;border:0;background:none;font-size:14.5px;height:44px;color:var(--foreground)}
+.message-compose input::placeholder{color:var(--subtle)}
+.message-send{display:flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:50%;color:var(--primary)}
+.message-send:disabled{color:var(--subtle)}
+
+/* ============================================================
+   14. REELS
+   ============================================================ */
+
+.reels-view{max-width:1000px;margin:0 auto;padding:14px 24px 0;display:flex;flex-direction:column;min-height:calc(100dvh - 80px)}
+.reels-heading{display:flex;align-items:center;justify-content:space-between;padding:6px 6px 14px}
+.reels-heading h1{font-size:24px;font-weight:750;letter-spacing:-.6px}
+.reels-track{flex:1 1 auto;min-height:0;overflow-y:auto;scroll-snap-type:y mandatory;overscroll-behavior-y:contain;display:flex;flex-direction:column;gap:14px;padding-bottom:14px;scrollbar-width:none}
+.reels-track::-webkit-scrollbar{display:none}
+.reel-item{height:100%;scroll-snap-align:start;scroll-snap-stop:always;display:flex;justify-content:center;min-height:0}
+.reel-player{position:relative;width:min(424px,100%);height:100%;border-radius:22px;overflow:hidden;background:#0a0a0c;box-shadow:var(--shadow-3);max-height:calc(100dvh - 150px)}
+.reel-player>video{width:100%;height:100%;object-fit:contain}
+.reel-top{position:absolute;top:12px;right:12px;display:flex;gap:6px;z-index:4}
+.reel-top .icon-button{background:rgba(15,15,20,.5);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);color:#fff;width:36px;height:36px;border-radius:50%}
+.reel-top .icon-button svg{width:19px;height:19px}
+.reel-play-large{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:3;color:#fff}
+.reel-loading{position:absolute;top:14px;left:14px;z-index:4;color:#fff;display:flex;background:rgba(15,15,20,.5);border-radius:50%;padding:8px}
+.reel-error{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px;color:#fff;background:rgba(10,10,12,.7);font-size:14.5px}
+.reel-info{position:absolute;left:14px;right:76px;bottom:20px;z-index:4;color:#fff;display:flex;flex-direction:column;gap:7px;filter:drop-shadow(0 1px 6px rgba(0,0,0,.55))}
+.reel-info .user-line{color:#fff;font-weight:600}
+.reel-info p{font-size:13.5px;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
+.reel-info small{opacity:.8;font-size:12px}
+.reel-actions{position:absolute;right:10px;bottom:52px;display:flex;flex-direction:column;align-items:center;gap:4px;z-index:4;color:#fff;filter:drop-shadow(0 1px 6px rgba(0,0,0,.55))}
+.reel-actions .icon-button{color:#fff;width:44px;height:44px}
+.reel-actions .icon-button svg{width:27px;height:27px}
+.reel-actions span{font-size:12.5px;font-weight:600;margin-bottom:5px}
+.reel-seek{position:absolute;left:14px;right:14px;bottom:8px;z-index:5;accent-color:var(--primary);height:18px;cursor:pointer}
+.reel-count{text-align:center;color:var(--muted-foreground);font-size:13px;padding:10px 0 4px}
+
+/* ============================================================
+   15. STORY VIEWER
+   ============================================================ */
+
+.story-dialog[data-slot=dialog-content]{max-width:none;width:100vw;height:100dvh;border-radius:0;border:0;background:var(--story-bg);max-height:none}
+.story-fullscreen{position:relative;width:100%;height:100dvh;display:flex;align-items:center;justify-content:center}
+.story-brand{position:absolute;left:22px;top:20px;z-index:6;color:#fff;font-size:26px}
+.story-player{position:relative;width:min(440px,100vw);max-height:94dvh;aspect-ratio:9/16;border-radius:22px;overflow:hidden;background:#000;box-shadow:var(--shadow-3)}
+.story-player>img,.story-player>video{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
+.story-progress{position:absolute;top:10px;left:10px;right:10px;z-index:6;display:flex;gap:4px}
+.story-progress span{flex:1;height:2.5px;border-radius:4px;background:rgba(255,255,255,.34);overflow:hidden}
+.story-progress i{display:block;height:100%;background:#fff;border-radius:4px}
+.story-player>header{position:absolute;top:22px;left:12px;right:12px;z-index:6;display:flex;align-items:center;gap:10px;color:#fff;filter:drop-shadow(0 1px 4px rgba(0,0,0,.5))}
+.story-player>header>button{font-weight:650;font-size:14.5px}
+.story-player>header>span{font-size:13px;opacity:.85;flex:1}
+.story-tools{display:flex;gap:5px}
+.story-tools .icon-button{color:#fff;width:33px;height:33px}
+.story-tools .icon-button svg{width:19px;height:19px}
+.story-tap{position:absolute;top:64px;bottom:70px;width:38%;z-index:5}
+.story-tap.previous{left:0}
+.story-tap.next{right:0}
+.story-caption{position:absolute;left:16px;right:16px;bottom:22px;z-index:6;color:#fff;font-size:16px;text-align:center;text-shadow:0 1px 8px rgba(0,0,0,.6)}
+.close-story{position:absolute;right:14px;top:16px;z-index:7;color:#fff}
+.story-prev,.story-next{position:absolute;top:50%;translate:0 -50%;z-index:7;color:#fff;background:rgba(255,255,255,.16);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-radius:50%}
+.story-prev{left:14px}
+.story-next{right:14px}
+
+/* ============================================================
+   16. SHARE / ABOUT / AUTH / GUEST
+   ============================================================ */
+
+.share-link{display:flex;gap:10px;margin:20px 22px 6px;align-items:center;padding:9px 12px;border:1px solid var(--input);border-radius:13px;background:var(--background)}
+.share-link input{min-width:0;flex:1;font-size:13px;background:none;color:var(--foreground)}
+.social-modal>.secondary-button{margin:12px 22px 16px;width:calc(100% - 44px)}
+.share-people{padding:6px 22px 18px}
+.share-people h3{font-size:13.5px;margin:6px 0 12px;font-weight:650}
+.about-modal .credits{padding:14px 22px;display:flex;flex-direction:column;gap:8px;font-size:13px}
+.about-modal .credits a{color:var(--primary)}
+.about-modal>p:last-of-type{margin-bottom:22px}
+.about-modal{max-width:560px}
+.delete-action{background:var(--destructive)!important;color:#fff}
+
+.guest-auth-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;max-width:1040px;margin:18px auto 0;border-radius:18px;padding:14px 20px}
+.guest-auth-bar p{font-size:14px;color:var(--muted-foreground)}
+.guest-auth-bar>div{display:flex;gap:8px;flex-shrink:0}
+.guest-auth-bar .primary-button,.guest-auth-bar .secondary-button{min-height:38px;padding:8px 16px;font-size:13.5px}
+.sign-in-content{padding:28px 28px 30px;display:flex;flex-direction:column;gap:24px;align-items:center}
+.sign-in-content p{font-size:13px;color:var(--muted-foreground)}
+
+.auth-form{display:grid;gap:15px;width:100%;text-align:left}
+.auth-form h2{font-size:21px;font-weight:700;letter-spacing:-.4px}
+.auth-form label{display:grid;gap:7px;font-size:14px;font-weight:600}
+.auth-form input{width:100%;padding:12px;border:1px solid var(--input);border-radius:12px;color:inherit;background:transparent;font-size:16px}
+.auth-form input:focus-visible{outline:2px solid var(--ring);outline-offset:0;border-color:transparent}
+.auth-form small{color:var(--muted-foreground);line-height:1.5;font-weight:400}
+.auth-form [role=alert]{color:var(--destructive);font-size:14px}
+.auth-form [role=status]{font-size:14px;color:var(--muted-foreground);line-height:1.6}
+.auth-form fieldset{display:grid;gap:15px;border:0;padding:0;margin:0;min-width:0}
+.auth-form .text-button{color:var(--primary);font-size:14px;min-height:44px}
+
+.setup-page{min-height:100vh;display:grid;place-items:center;background:var(--canvas);padding:24px;color:var(--foreground)}
+.setup-card{width:min(560px,100%);border:1px solid var(--border);border-radius:22px;background:var(--card);padding:36px;box-shadow:var(--shadow-2)}
+.setup-card h1{font-size:29px;margin:22px 0 12px;letter-spacing:-.6px}
+.setup-card p,.setup-card li{line-height:1.7;color:var(--muted-foreground)}
+.setup-card code{font-size:13px;color:var(--foreground)}
+.setup-card .eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:2px;color:var(--primary)}
+
+/* ============================================================
+   17. RESPONSIVE — tablet, mobile, small mobile
+   ============================================================ */
+
+@media (max-width:1200px){
+  .home-layout{grid-template-columns:minmax(0,640px);justify-content:center;max-width:730px;padding:24px 32px 0}
+  .suggestions-rail{display:none}
+  .discovery-view,.profile-view{padding:30px 26px}
+  .profile-top{gap:38px;margin:10px 5px 36px}
+  .messages-layout{grid-template-columns:290px minmax(0,1fr)}
+  .conversation-list{padding:20px 10px 12px}
+}
+
+/* narrow layouts (phones + tablets): the floating dock replaces the sidebar */
+@media (max-width:1080px){
+  .app-sidebar{display:none}
+  .mobile-header{display:flex}
+  .dock-wrap{display:flex}
+  /* Content clears the fixed header above (plus any notch) and keeps
+     breathing room for the floating bar below: bar height + the gap +
+     safe area + a little slack. */
+  .main-surface{margin-left:0;width:100%;padding-top:calc(60px + env(safe-area-inset-top));padding-bottom:calc(var(--dock-inset) + 8px)}
+  .home-layout{padding-bottom:8px}
+  .discovery-view,.profile-view,.notifications-view{padding-bottom:8px}
+  .reels-track{padding-bottom:calc(var(--dock-inset) - 44px)}
+  .feed-end{padding-bottom:26px}
+  /* The chat compose box must stay clear of the floating bar. */
+  .messages-layout{height:calc(100dvh - 60px - env(safe-area-inset-top) - var(--dock-inset) - 8px)}
+}
+
+/* Small phones: a slightly slimmer pill that still clears the edges. */
+@media (max-width:400px){
+  :root{--dock-height:60px}
+  .dock{padding:5px}
+  .dock-glyph{width:42px;height:42px}
+  .dock-glyph svg{width:23px;height:23px}
+  .dock-create .dock-glyph{width:42px;height:42px}
+  .dock-create .dock-glyph svg{width:21px;height:21px}
+  .dock-item .avatar{width:26px!important;height:26px!important}
+}
+
+/* large phones and tablets: a little taller, capped at 480px on tablets */
+@media (min-width:430px) and (max-width:1080px){
+  :root{--dock-height:64px;--dock-max:480px}
+}
+
+/* landscape phones: the bar stays a compact centred control */
+@media (max-height:520px) and (max-width:1080px){
+  :root{--dock-height:54px;--dock-max:400px}
+  .dock{padding:4px}
+  .dock-glyph,.dock-create .dock-glyph{width:38px;height:38px}
+  .dock-glyph svg{width:21px;height:21px}
+}
+
+/* desktop: full sidebar returns, dock and mobile header step away */
+@media (min-width:1081px){
+  .dock-wrap,.mobile-header{display:none!important}
+  .main-surface{margin-left:252px;width:calc(100% - 252px)}
+}
+
+/* tablet: icon rail sidebar */
+@media (min-width:1081px) and (max-width:1200px){
+  .app-sidebar{width:82px;padding:26px 12px 16px;align-items:center}
+  .app-sidebar>.brand{font-size:0;letter-spacing:0;width:50px;text-align:center;padding:2px 0 24px}
+  .app-sidebar>.brand:before{content:"R";font-size:28px;letter-spacing:-1.6px}
+  .app-sidebar>.brand>span{font-size:28px;letter-spacing:-1.6px}
+  .main-surface{margin-left:82px;width:calc(100% - 82px)}
+  .nav-link{justify-content:center;padding:0;gap:0;height:52px;border-radius:14px}
+  .nav-link>span:not(.nav-icon){display:none}
+  .nav-link.nav-active::before{display:none}
+  .sidebar-footer{align-items:center;margin:0;padding:12px 0 0}
+  .sidebar-footer .nav-link>span:not(.nav-icon){display:none}
+  .sidebar-footer .nav-link{justify-content:center;padding:0}
+  .home-layout{max-width:730px;padding:22px 30px 0}
+  .profile-title h1{width:100%;margin:0 0 4px}
+  .messages-layout{grid-template-columns:255px minmax(0,1fr);padding:0 14px 16px}
+  .conversation-list{padding:18px 8px 10px}
+  .chat-panel>header{padding:14px 10px}
+  .message-compose{margin:10px 12px 14px}
+  .people-results{column-gap:20px}
+  .person-result .person-detail>span{max-width:150px}
+  .reels-view{padding:12px 16px 0}
+  .discovery-view{padding:26px 20px}
+  .profile-view{padding:26px 20px}
+}
+
+/* mobile */
+@media (max-width:700px){
+  .home-layout{display:block;padding:0;max-width:560px}
+  .feed-tabs[data-slot=tabs-list]{height:50px;gap:26px;padding:0 16px}
+  .feed-tabs [data-slot=tabs-trigger]{font-size:16px;padding-top:15px;padding-bottom:13px}
+  .stories-wrapper{padding:14px 0 14px}
+  .stories{padding:1px 14px 3px;gap:13px}
+  .story{flex-basis:66px;font-size:11.5px}
+  .story .avatar{width:62px!important;height:62px!important}
+  .story .your-story .avatar{width:58px!important;height:58px!important}
+  .stories-next{display:none!important}
+  .post-header{padding:11px 13px;min-height:64px;gap:10px}
+  .post-header .avatar{width:37px!important;height:37px!important}
+  .username{font-size:13.5px}
+  .post-time{font-size:12.5px}
+  .post-location{font-size:12px}
+  .post-card{margin-bottom:14px;padding-bottom:10px}
+  .post-media .media-frame,.carousel{border-radius:0}
+  .post-body{padding:0 13px}
+  .post-actions{padding-top:5px;padding-bottom:2px;gap:4px;margin-left:-6px}
+  .post-actions>.icon-button{width:37px;height:38px}
+  .post-caption{font-size:13.5px;line-height:1.6}
+  .like-count,.view-comments,.comment-form input{font-size:13.5px}
+  .comment-form{border-top:0;margin:0 -6px 0}
+  .feed-end{padding:28px 10px 18px}
+  .discovery-view,.profile-view{padding:22px 14px 8px}
+  .section-heading h1{font-size:23px}
+  .section-heading>span{font-size:13px}
+  .search-field.large{margin-bottom:18px}
+  .people-results{grid-template-columns:1fr}
+  .people-results .person-result{padding:10px 0}
+  .category-tabs[data-slot=tabs-list]{margin-bottom:16px;gap:7px}
+  .category-tabs [data-slot=tabs-trigger]{font-size:12.5px;padding:8px 13px}
+  .photo-grid{margin:0 -14px;gap:3px}
+  .masonry-grid{columns:2;column-gap:3px;margin:0 -14px}
+  .masonry-tile{border-radius:0;margin-bottom:3px}
+  .grid-photo{border-radius:0}
+  .grid-hover{font-size:12px;flex-wrap:wrap;gap:4px;padding:8px}
+  .grid-hover svg{width:14px;height:14px}
+  .profile-top{margin:0 0 22px;gap:22px;align-items:start}
+  .profile-top .avatar{width:86px!important;height:86px!important;margin-top:4px}
+  .profile-info{min-width:0}
+  .profile-title{gap:7px;margin-bottom:14px}
+  .profile-title h1{font-size:19px;width:100%;margin:0 0 4px}
+  .profile-title .secondary-button,.profile-title .primary-button{font-size:12.5px;min-height:33px;padding:8px 13px}
+  .profile-stats{gap:16px;flex-wrap:wrap;font-size:12.5px;margin-bottom:12px}
+  .profile-stats strong{display:block;font-size:14.5px}
+  .profile-name{font-size:13.5px}
+  .profile-bio{font-size:13.5px}
+  .profile-tabs[data-slot=tabs-list]{gap:30px;height:52px;margin-bottom:6px}
+  .profile-tabs [data-slot=tabs-trigger]{font-size:11.5px}
+  .notifications-view{padding:20px 14px}
+  .notification-row{gap:11px;padding:14px 4px;font-size:13.5px}
+  .notification-row>img{width:44px;height:44px}
+  .empty-state{padding:42px 22px}
+  .empty-state h2{font-size:19px}
+  .empty-state p{font-size:13.5px}
+
+  /* messages: single-thread view */
+  .messages-layout{height:calc(100dvh - 60px - env(safe-area-inset-top) - var(--dock-inset) - 8px);grid-template-columns:1fr;padding:0 0 0}
+  .conversation-list{border-right:0;padding:16px 12px 10px}
+  .chat-panel{display:none}
+  .messages-layout.show-chat .conversation-list{display:none}
+  .messages-layout.show-chat .chat-panel{display:flex}
+  .chat-back{display:inline-flex}
+  .chat-panel>header{padding:12px 12px;min-height:64px;gap:8px}
+  .chat-content{padding:18px 12px}
+  .message-compose{margin:8px 10px 14px}
+  .message-row{max-width:84%}
+
+  /* reels: immersive */
+  .reels-view{padding:0;min-height:calc(100dvh - 60px - env(safe-area-inset-top) - var(--dock-inset) - 8px)}
+  .reels-heading{padding:10px 16px 12px}
+  .reels-heading h1{font-size:21px}
+  .reels-track{gap:0;padding:0 0 calc(var(--dock-inset) - 46px)}
+  .reel-item{padding:0}
+  .reel-player{width:100%;height:100%;max-height:none;border-radius:0;box-shadow:none}
+  .reel-info{left:14px;right:64px;bottom:34px}
+  .reel-actions{right:6px;bottom:96px}
+  .reel-count{display:none}
+
+  /* modals become bottom sheets */
+  .social-modal[data-slot=dialog-content]{
+    top:auto;bottom:0;left:0;right:0;translate:0 0;
+    width:100%;max-width:none;max-height:92dvh;
+    border-radius:24px 24px 0 0;border-bottom:0;
+  }
+  .modal-heading{padding:18px 20px 15px;padding-right:48px;border-radius:24px 24px 0 0}
+  .create-form{padding:12px 16px 18px}
+  .upload-drop{min-height:210px}
+  .post-viewer{width:100vw;height:100dvh;max-height:100dvh}
+  .post-viewer[data-slot=dialog-content]{top:0;bottom:0;left:0;right:0;translate:0 0;border-radius:0}
+  .post-viewer-layout{display:flex;flex-direction:column;height:100dvh}
+  .post-viewer-media{flex:0 0 auto;max-height:46dvh;min-height:34dvh;border-radius:0}
+  .post-viewer-media .media-frame,.post-viewer-media .carousel{max-height:46dvh}
+  .post-viewer-media .media-frame{height:100%}
+  .post-viewer-panel{flex:1 1 auto;min-height:0;border-radius:0;border-left:0}
+  .post-viewer-side{padding:10px 14px 8px}
+  .post-viewer-header{padding:10px 14px}
+  .post-viewer-comments{padding:10px 14px}
+  .post-viewer-compose{border-radius:0;padding:2px 6px 6px}
+  .close-post{top:8px;right:8px}
+  .relations-modal .relations-list{max-height:56dvh}
+  .share-link{margin:16px 16px 4px}
+  .social-modal>.secondary-button{margin:10px 16px 14px;width:calc(100% - 32px)}
+  .share-people{padding:4px 16px 14px}
+  .guest-auth-bar{margin:10px 12px 0;padding:11px 14px;flex-wrap:wrap}
