+  --glass-nav:rgba(15,15,20,.6);
+  --glass-strong:rgba(22,22,28,.82);
+  --glass-soft:rgba(20,20,26,.5);
+  --glass-border:rgba(255,255,255,.09);
+  --glass-highlight:inset 0 1px 0 rgba(255,255,255,.07);
+
+  --dock-bg:rgba(19,19,24,.64);
+  --dock-border:rgba(255,255,255,.12);
+  --dock-highlight:inset 0 1px 0 rgba(255,255,255,.09);
+  --dock-shadow:0 2px 8px rgba(0,0,0,.4),0 18px 38px -14px rgba(0,0,0,.72),inset 0 1px 0 rgba(255,255,255,.07);
+  --dock-pill:rgba(255,255,255,.14);
+  --dock-pill-border:rgba(255,255,255,.1);
+  --dock-pill-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 4px 12px -4px rgba(0,0,0,.5);
+  --dock-fallback:#15151a;
+
+  --shadow-1:0 1px 2px rgba(0,0,0,.4);
+  --shadow-2:0 2px 6px rgba(0,0,0,.45),0 8px 24px -8px rgba(0,0,0,.5);
+  --shadow-3:0 4px 12px rgba(0,0,0,.5),0 24px 64px -16px rgba(0,0,0,.66);
