+}
+
+@theme inline {
+  --color-background:var(--background);
+  --color-foreground:var(--foreground);
+  --color-card:var(--card);
+  --color-card-foreground:var(--card-foreground);
+  --color-popover:var(--popover);
+  --color-popover-foreground:var(--popover-foreground);
+  --color-primary:var(--primary);
+  --color-primary-foreground:var(--primary-foreground);
+  --color-secondary:var(--secondary);
+  --color-secondary-foreground:var(--secondary-foreground);
+  --color-muted:var(--muted);
+  --color-muted-foreground:var(--muted-foreground);
+  --color-accent:var(--accent);
+  --color-accent-foreground:var(--accent-foreground);
+  --color-destructive:var(--destructive);
+  --color-border:var(--border);
+  --color-input:var(--input);
+  --color-ring:var(--ring);
+  --color-sidebar:var(--sidebar);
+  --color-sidebar-foreground:var(--sidebar-foreground);
+  --color-sidebar-primary:var(--sidebar-primary);
+  --color-sidebar-primary-foreground:var(--sidebar-primary-foreground);
+  --color-sidebar-accent:var(--sidebar-accent);
+  --color-sidebar-accent-foreground:var(--sidebar-accent-foreground);
+  --color-sidebar-border:var(--sidebar-border);
+  --color-sidebar-ring:var(--sidebar-ring);
+  --radius-sm:calc(var(--radius) - 4px);
+  --radius-md:calc(var(--radius) - 2px);
+  --radius-lg:var(--radius);
+  --radius-xl:calc(var(--radius) + 4px);
+  --font-sans:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
+}
+
+/* ============================================================
+   2. BASE
+   ============================================================ */
+
+*{box-sizing:border-box}
+html{scroll-behavior:smooth;scroll-padding-top:70px;-webkit-text-size-adjust:100%}
+body{
+  margin:0;background:var(--canvas);color:var(--foreground);
+  font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
+  font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
+  overflow-wrap:break-word;
+}
+button,input,textarea{font:inherit}
+button,a,input,textarea{-webkit-tap-highlight-color:transparent}
+button,a{touch-action:manipulation}
+button{cursor:pointer}
+button:disabled{cursor:default;opacity:.45}
+button:focus-visible,a:focus-visible{outline:2px solid var(--primary);outline-offset:3px;border-radius:6px}
+input,textarea{outline:none}
+input:focus-visible,textarea:focus-visible{outline:2px solid var(--ring);outline-offset:1px}
+button{transition:background var(--motion-fast),color var(--motion-fast),opacity var(--motion-fast),transform var(--motion-fast),box-shadow var(--motion-fast)}
+a{color:inherit}
+img,video{display:block;max-width:100%}
+svg{flex-shrink:0;stroke-width:1.85}
+h1,h2,h3,p{margin:0}
+::selection{background:var(--accent);color:var(--accent-foreground)}
+
+.muted{color:var(--muted-foreground)}
+.spin{animation:spin 1s linear infinite}
+@keyframes spin{to{transform:rotate(360deg)}}
+.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
+
+.skip-link{position:fixed;top:-90px;left:16px;z-index:200;background:var(--background);color:var(--foreground);border:1px solid var(--border);border-radius:12px;padding:12px 18px;box-shadow:var(--shadow-2);transition:top var(--motion)}
+.skip-link:focus{top:12px}
+
+/* ============================================================
+   3. APP SHELL & NAVIGATION
+   ============================================================ */
+
+.app-shell{min-height:100dvh}
+.brand{font-size:31px;line-height:1.15;font-weight:900;letter-spacing:-1.7px;white-space:nowrap;display:inline-block;color:var(--foreground)}
+.brand>span{color:var(--primary)}
+
+/* desktop sidebar — liquid glass */
+.app-sidebar{
+  position:fixed;inset:0 auto 0 0;width:252px;z-index:var(--z-sidebar);
+  display:flex;flex-direction:column;gap:6px;padding:30px 16px 18px;
+  background:var(--glass-nav);
+  -webkit-backdrop-filter:var(--glass-blur);backdrop-filter:var(--glass-blur);
+  border-right:1px solid var(--glass-border);
+  box-shadow:var(--glass-shadow);
+}
+@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){
+  .app-sidebar{background:var(--background)}
+}
+.app-sidebar>.brand{padding:2px 18px 22px;text-align:left}
+.main-nav{display:flex;flex-direction:column;gap:5px;flex:1 1 auto;min-height:0;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;scrollbar-width:none}
+.main-nav::-webkit-scrollbar{display:none}
+.nav-link{
+  height:50px;padding:0 15px;border-radius:13px;display:flex;align-items:center;gap:17px;
+  font-size:15.5px;font-weight:450;width:100%;text-align:left;color:var(--foreground);
+  position:relative;transition:background var(--motion-fast),color var(--motion-fast),transform var(--motion-fast);
+}
+.nav-link svg{width:25px;height:25px;transition:transform var(--motion)}
+.nav-link:hover{background:var(--muted)}
+.nav-link:active{transform:scale(.97)}
+.nav-link.nav-active{background:var(--accent);color:var(--accent-foreground);font-weight:650}
+.nav-link.nav-active::before{
+  content:"";position:absolute;left:-16px;top:50%;translate:0 -50%;width:3.5px;height:26px;border-radius:0 4px 4px 0;background:var(--primary);
+}
+.nav-icon{position:relative;display:inline-flex}
+.nav-icon>i{position:absolute;width:7.5px;height:7.5px;border-radius:100%;background:var(--primary);top:-1px;right:-4px;border:1.5px solid var(--background)}
+.sidebar-footer{display:flex;flex-direction:column;gap:5px;padding:12px 0 0;border-top:1px solid var(--glass-border);margin:0 2px}
+.more-menu{min-width:215px}
+
+.main-surface{margin-left:252px;width:calc(100% - 252px);min-width:0}
+
+/* view switching transitions */
+.view-transition{animation:view-in var(--motion-slow) var(--ease)}
+@keyframes view-in{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}
+
+/* mobile chrome — liquid glass */
+.mobile-header,.dock-wrap{display:none}
+/* Always fixed, always visible: the header never reacts to scrolling. */
+.mobile-header{
+  position:fixed;top:0;left:0;right:0;z-index:var(--z-header);height:60px;
+  padding:0 16px;padding-top:env(safe-area-inset-top);
+  align-items:center;justify-content:space-between;
+  background:var(--glass-nav);
+  -webkit-backdrop-filter:var(--glass-blur);backdrop-filter:var(--glass-blur);
+  border-bottom:1px solid var(--glass-border);
+}
+.mobile-header .brand{font-size:27px;letter-spacing:-1.4px}
+.mobile-header>div{display:flex;gap:4px}
+.mobile-header .icon-button{width:37px;height:40px}
+.mobile-header .icon-button svg{width:23px;height:23px}
+
+/* ------------------------------------------------------------
+   Floating dock. A full-width fixed strip centres the pill with
+   flexbox, and only the inner pill carries the hide/show
+   transform — strictly on the Y axis, so the two jobs can never
+   overwrite each other and the pill stays centred at every
+   width, in and out of the hidden state.
+   ------------------------------------------------------------ */
+.dock-wrap{
+  position:fixed;left:0;right:0;
+  bottom:max(16px, calc(env(safe-area-inset-bottom) + 12px));
+  z-index:var(--z-header);
+  display:flex;justify-content:center;
+  pointer-events:none;
+}
+.dock{
+  pointer-events:auto;
+  width:min(100% - 24px, var(--dock-max));
+  height:var(--dock-height);padding:6px;
+  display:flex;align-items:center;
+  border-radius:var(--dock-radius);
+  background:var(--dock-bg);
+  -webkit-backdrop-filter:var(--dock-blur);backdrop-filter:var(--dock-blur);
+  border:1px solid var(--dock-border);
+  box-shadow:var(--dock-shadow);
+  transform:translate3d(0,0,0) scale(1);
+  transition:transform 260ms var(--ease),opacity 200ms var(--ease),visibility 0s linear 0s;
+}
+/* Auto-hide: the pill travels past the bottom edge instead of popping out. */
+.dock-wrap[data-state=hidden] .dock,
+.dock-wrap.dock-hidden .dock,
+.dock-wrap[inert] .dock{
+  transform:translate3d(0, calc(100% + max(16px, env(safe-area-inset-bottom)) + 18px), 0) scale(.985);
+  opacity:0;visibility:hidden;pointer-events:none;
+  transition:transform 240ms var(--ease),opacity 180ms var(--ease),visibility 0s linear 240ms;
+}
+.dock-list{position:relative;flex:1;display:flex;align-items:center;height:100%;min-width:0}
+/* Sliding active capsule — its own depth layer inside the glass. */
+.dock-indicator{
+  position:absolute;left:0;top:0;width:48px;height:48px;border-radius:50%;
+  background:var(--dock-pill);border:1px solid var(--dock-pill-border);
+  box-shadow:var(--dock-pill-shadow);
+  pointer-events:none;z-index:0;opacity:0;
+  transform:translate3d(6px,0,0);
+}
+.dock-list[data-dock-ready=true] .dock-indicator{
+  opacity:1;
+  transition:transform 230ms var(--ease),width 230ms var(--ease),height 230ms var(--ease),opacity 160ms var(--ease);
+}
+.dock-item{
+  position:relative;z-index:1;flex:1 1 0;min-width:0;
+  height:calc(var(--dock-height) - 12px);
+  display:flex;align-items:center;justify-content:center;
+  border-radius:50%;color:var(--foreground);background:none;border:0;padding:0;
+  -webkit-tap-highlight-color:transparent;
+}
+.dock-item:focus-visible{outline:2px solid var(--primary);outline-offset:2px}
+.dock-glyph{
+  display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;
+  transition:transform 170ms var(--ease),color var(--motion-fast) var(--ease),opacity var(--motion-fast) var(--ease);
+}
+.dock-glyph svg{width:24px;height:24px}
+.dock-item[data-active=false]{color:var(--muted-foreground);opacity:.9}
+.dock-item[data-active=true]{color:var(--foreground)}
+.dock-item[data-active=true][data-id=home]{color:var(--primary)}
+.dock-item:active .dock-glyph{transform:scale(.92)}
+.dock-item[data-active=true] .dock-glyph{transform:scale(1.04)}
+.dock-item[data-active=true]:active .dock-glyph{transform:scale(.95)}
+/* Profile keeps its avatar, ringed by the active capsule. */
+.dock-item .avatar{outline:2px solid transparent;outline-offset:2px;transition:outline-color var(--motion) var(--ease),transform 170ms var(--ease)}
+.dock-item[data-active=true] .avatar{outline-color:var(--primary)}
+/* Create is an action, not a destination: it stays visually distinct. */
+.dock-create .dock-glyph{
+  width:44px;height:44px;color:#fff;
+  background:linear-gradient(180deg,#f0507a,var(--primary) 55%,#e23b66);
+  box-shadow:0 2px 8px -2px rgba(235,69,110,.65),inset 0 1px 0 rgba(255,255,255,.28);
+}
+.dock-create .dock-glyph svg{width:22px;height:22px}
+.dock-create:active .dock-glyph{transform:scale(.93)}
+/* Readable fallback where backdrop-filter is unavailable. */
+@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){
+  .dock{background:var(--dock-fallback)}
+}
+
+/* ============================================================
+   4. PRIMITIVES — buttons, icons, avatars, glass cards
+   ============================================================ */
+
+.icon-button{
+  display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;flex-shrink:0;
+  padding:6px;border-radius:12px;color:inherit;position:relative;
+  transition:background var(--motion-fast),color var(--motion-fast),transform var(--motion-fast);
+}
+.icon-button:hover{background:var(--muted)}
+.icon-button:active{transform:scale(.92)}
+.icon-button svg{width:25px;height:25px}
+.icon-button.is-active{color:var(--primary)}
+
+.primary-button,.secondary-button,.follow-button,.text-action,.text-button{
+  display:inline-flex;align-items:center;justify-content:center;gap:8px;
+  border-radius:13px;font-size:14.5px;font-weight:620;min-height:42px;padding:10px 20px;
+  text-decoration:none;line-height:1.4;transition:transform var(--motion-fast),box-shadow var(--motion-fast),background var(--motion-fast),color var(--motion-fast),opacity var(--motion-fast);
+}
+.primary-button{background:linear-gradient(180deg,#f0507a,var(--primary) 55%,#e23b66);color:#fff;box-shadow:var(--shadow-1)}
+.primary-button:hover{transform:translateY(-1px);box-shadow:var(--shadow-2)}
+.primary-button:active{transform:scale(.97)}
+.secondary-button{background:var(--secondary);color:var(--foreground)}
+.secondary-button:hover{background:var(--input);transform:translateY(-1px)}
+.secondary-button:active{transform:scale(.97)}
+.secondary-button.icon-only{padding:0 13px}
+.follow-button{background:var(--primary);color:#fff;font-size:13.5px;min-height:34px;padding:7px 16px;border-radius:10px;box-shadow:var(--shadow-1)}
+.follow-button:hover{transform:translateY(-1px);box-shadow:var(--shadow-2)}
+.follow-button:active{transform:scale(.97)}
+.follow-button.following{background:var(--secondary);color:var(--foreground)}
+.text-action{background:none;color:var(--primary);min-height:36px;padding:4px 8px}
+.text-action:disabled{opacity:.4}
+.text-button{background:none;color:var(--primary);min-height:44px}
+.wide{width:100%}
+
+.glass-card{
+  background:var(--glass-soft);
+  -webkit-backdrop-filter:var(--glass-blur);backdrop-filter:var(--glass-blur);
+  border:1px solid var(--glass-border);border-radius:18px;box-shadow:var(--shadow-1);
+}
+@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){
+  .glass-card{background:var(--background)}
+}
+
+/* avatars */
+.avatar{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:50%;background:var(--muted);overflow:hidden;vertical-align:middle;transition:transform .18s var(--ease);border:1px solid var(--border)}
+.avatar img{width:100%;height:100%;object-fit:cover}
+.avatar-initial{width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(140deg,#f8e7ed,#fbdce8);color:#b13058;font-weight:700;font-size:1.35em}
+[data-theme=dark] .avatar-initial{background:linear-gradient(140deg,#3a2029,#33202c);color:#ff7497}
+.avatar-ring{padding:3px;background:conic-gradient(from 200deg,#ffbe49,#f74774 45%,#e931a9 75%,#b83dff);border:0}
+.avatar-ring img,.avatar-ring .avatar-initial{border:3px solid var(--background);border-radius:50%;width:100%;height:100%}
+.story-seen .avatar-ring{background:var(--input)}
+.avatar-button{display:flex;flex-shrink:0;border-radius:50%}
+button:hover>.avatar{transform:scale(1.04)}
+
+/* ============================================================
+   5. STATES — empty, loading, skeletons
+   ============================================================ */
+
+.empty-state{text-align:center;padding:60px 24px;display:flex;align-items:center;flex-direction:column;gap:13px;max-width:460px;margin:auto}
+.empty-icon{display:flex;border:1.5px solid var(--foreground);border-radius:50%;padding:18px;margin-bottom:4px}
+.empty-icon svg{width:29px;height:29px}
+.empty-state h2{font-size:21px;font-weight:650;letter-spacing:-.4px;line-height:1.3}
+.empty-state p{font-size:14px;color:var(--muted-foreground);max-width:320px;line-height:1.65}
+.loading-screen,.loading-row{display:flex;align-items:center;justify-content:center;gap:12px;padding:56px 20px;color:var(--muted-foreground)}
+.loading-screen{min-height:60vh}
+
+.skeleton{display:block;position:relative;overflow:hidden;background:var(--muted);border-radius:10px}
+.skeleton::after{content:"";position:absolute;inset:0;transform:translateX(-100%);background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);animation:shimmer 1.6s infinite}
+[data-theme=dark] .skeleton::after{background:linear-gradient(90deg,transparent,rgba(255,255,255,.07),transparent)}
+@keyframes shimmer{to{transform:translateX(100%)}}
+.skeleton-circle{width:42px;height:42px;border-radius:50%}
+.skeleton-bar{height:12px;border-radius:6px}
+.post-skeleton .post-header{align-items:center}
+.skeleton-media{width:100%;aspect-ratio:1.25;border-radius:16px;margin-bottom:14px}
+.post-skeleton .post-actions{padding-top:12px}
+.post-skeleton .skeleton-circle{width:34px;height:34px}
+
+/* ============================================================
+   6. HOME FEED
+   ============================================================ */
+
+.home-layout{display:grid;grid-template-columns:minmax(0,630px) 300px;gap:56px;max-width:1080px;margin:0 auto;padding:28px 34px 0}
+.feed-column{min-width:0}
+
+.feed-tabs[data-slot=tabs-list]{width:100%;height:48px;border-bottom:1px solid var(--border);border-radius:0;justify-content:start;padding:0;gap:26px;background:none}
+.feed-tabs [data-slot=tabs-trigger]{padding:0 0 14px;flex:0 0 auto;height:100%;font-size:17px;font-weight:600;color:var(--muted-foreground);border:0;border-radius:0}
+.feed-tabs [data-slot=tabs-trigger][data-state=active]{color:var(--foreground)}
+.feed-tabs [data-slot=tabs-trigger]:after{bottom:-1px!important;left:0!important;right:0!important;height:2px!important;border-radius:2px 2px 0 0;transition:width var(--motion) var(--ease)}
+
+/* stories */
+.stories-wrapper{position:relative;padding:20px 0 18px;border-bottom:1px solid var(--border)}
+.stories{display:flex;gap:16px;overflow-x:auto;scrollbar-width:none;padding:2px 0 3px;-webkit-overflow-scrolling:touch}
+.stories::-webkit-scrollbar{display:none}
+.story{display:flex;align-items:center;flex-direction:column;gap:7px;flex:0 0 72px;min-width:0;font-size:12px;line-height:1.35;color:var(--muted-foreground)}
+.story>span:last-child{max-width:80px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
+.your-story{position:relative;margin:2px 0;display:block}
+.your-story .avatar{opacity:.85}
+.story-plus{position:absolute;bottom:0;right:-2px;width:24px;height:24px;border-radius:50%;border:3px solid var(--background);background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:var(--shadow-1)}
+.stories-next.icon-button{position:absolute;right:-10px;top:46px;width:30px;height:30px;background:var(--background);box-shadow:var(--shadow-2);border-radius:50%;border:1px solid var(--border)}
+.stories-next.icon-button svg{width:16px;height:16px}
+
+/* post card */
+.post-card{padding:0 0 18px;margin-bottom:22px;position:relative}
+.post-header{display:flex;gap:11px;align-items:center;min-height:68px;padding:10px 2px}
+.post-user{min-width:0;flex:1;line-height:1.35}
+.post-user>div{display:flex;align-items:center;gap:3px;flex-wrap:wrap}
+.username{font-size:14px;font-weight:650;line-height:1.45;color:var(--foreground);overflow-wrap:anywhere}
+.username:hover{text-decoration:underline;text-underline-offset:3px}
+.post-time{font-size:13px;color:var(--muted-foreground)}
+.post-location{font-size:12.5px;line-height:1.6;display:block;color:var(--muted-foreground)}
+
+.post-media{position:relative}
+.media-frame{position:relative;width:100%;overflow:hidden;border-radius:18px;background:var(--muted);box-shadow:var(--shadow-1)}
+.media-frame img,.media-frame video{width:100%;height:100%;object-fit:cover}
+.media-frame.media-contain{background:#0c0c0f;display:flex;align-items:center;justify-content:center}
+.media-frame.media-contain img,.media-frame.media-contain video{object-fit:contain}
+
+.image-number{position:absolute;top:12px;right:12px;border-radius:20px;background:rgba(15,15,20,.55);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);color:#fff;font-size:12px;padding:4px 10px;z-index:3}
+.carousel{position:relative;width:100%;border-radius:18px;overflow:hidden;background:var(--muted);box-shadow:var(--shadow-1)}
+.carousel-track{height:100%}
+.carousel-slide{min-width:0;min-height:0;height:100%}
+.carousel-slide .media-frame{border-radius:0;box-shadow:none;height:100%;max-height:none}
+.carousel-back,.carousel-next{position:absolute;top:calc(50% - 16px);border-radius:50%;width:32px;height:32px;background:rgba(255,255,255,.92);color:#26262c;box-shadow:var(--shadow-2);z-index:4}
+.carousel-back{left:10px}
+.carousel-next{right:10px}
+.carousel-dots{position:absolute;bottom:12px;left:50%;translate:-50% 0;display:flex;gap:6px;z-index:4}
+.carousel-dots span{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.55);transition:background var(--motion-fast),width var(--motion-fast)}
+.carousel-dots span.active{background:#fff}
+
