+  </section>
+  <form className="admin-card admin-confirm" onSubmit={save}><h2>{editor.id?'Edit page':'Create page'}</h2><div className="admin-detail">{field('title','Public page title',120)}{field('slug','URL slug',80)}{field('seoTitle','SEO title',160)}{field('seoDescription','SEO description',320)}{field('ogImage','Open Graph image (safe HTTPS or local path)',2048)}<label>Footer order<input type="number" min={0} max={1000} value={editor.footerOrder} onChange={event=>setEditor({...editor,footerOrder:Number(event.target.value)})}/></label></div>
